    <string name="accessibility_label">OpenLiquidLauncher-Gesten</string>
    <string name="accessibility_description">Ermöglicht OpenLiquidLauncher, den Bildschirm per Doppeltipp zu sperren und die Benachrichtigungsleiste durch Wischen nach unten zu öffnen. Es werden keine Inhalte gelesen.</string>

