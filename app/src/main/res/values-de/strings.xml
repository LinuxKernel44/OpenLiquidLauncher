    <string name="settings_roundness">Rundung</string>
    <string name="settings_roundness_hint">Eckenrundung von Ordnern, Dock, Menüs, Karten und Panels. 50 = das Originaldesign.</string>
    <string name="settings_folder_roundness">Ordnerrundung</string>
    <string name="settings_folder_roundness_hint">Eckenrundung nur für Ordner: das Symbol auf dem Startbildschirm und der geöffnete Ordner.</string>
    <string name="settings_droplet_look">Tropfen-Look</string>
    <string name="settings_droplet_look_hint">Lässt Ordner, Dock, Schaltflächen, den Scroll-Griff und Menüs klarer, runder und lichtbrechender wirken, wie ein Wassertropfen. 0 = das Originaldesign.</string>
