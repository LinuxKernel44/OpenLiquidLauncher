    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Willkommen bei OpenLiquidLauncher</string>
    <string name="onboarding_welcome_body">Eine kurze Einrichtung, dann bist du fertig. Du kannst jeden Schritt überspringen und später alles in den Einstellungen ändern.</string>
    <string name="onboarding_get_started">Loslegen</string>
    <string name="onboarding_wallpaper_title">Wähle dein Hintergrundbild</string>
    <string name="onboarding_wallpaper_body">Wähle ein Bild aus deiner Galerie. Das Glas der gesamten App bricht es live.</string>
    <string name="onboarding_default_title">Als Standard-Launcher festlegen</string>
    <string name="onboarding_default_body">Mache OpenLiquidLauncher zu deinem Startbildschirm, damit er sich automatisch öffnet, wenn du auf Home drückst.</string>
    <string name="onboarding_default_done">Fertig — OpenLiquidLauncher ist dein Standard-Launcher.</string>
    <string name="onboarding_permissions_title">Optionale Berechtigungen</string>
    <string name="onboarding_permissions_body">Beide sind standardmäßig deaktiviert und lesen keine Inhalte — aktiviere nur, was du möchtest.</string>
    <string name="onboarding_gestures_label">Gesten-Shortcuts</string>
    <string name="onboarding_gestures_body">Doppeltippen zum Sperren des Bildschirms, nach unten wischen, um Benachrichtigungen zu öffnen.</string>
    <string name="onboarding_import_title">Nimm dein Layout mit</string>
    <string name="onboarding_import_body">Kopiere Dock, Ordner und Seiten von deinem aktuellen Launcher.</string>
    <string name="onboarding_import_button">Jetzt importieren</string>
    <string name="onboarding_done_title">Du bist startklar</string>
    <string name="onboarding_done_body">Viel Spaß mit dem Glas. Diese Anleitung findest du jederzeit unter Einstellungen → System.</string>
    <string name="onboarding_finish">OpenLiquidLauncher jetzt verwenden</string>
