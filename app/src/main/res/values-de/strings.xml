    <string name="settings_title">Einstellungen</string>
    <string name="settings_section_launch_animation">Startanimation</string>
    <string name="settings_launch_animation_hint">Wie der Startbildschirm erscheint, wenn du aus einer App zurückkehrst oder den Launcher startest.</string>
    <string name="settings_style_label">Stil</string>
    <string name="settings_speed_label">Geschwindigkeit</string>
