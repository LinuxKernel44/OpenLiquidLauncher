<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenLiquidLauncher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.OpenLiquidLauncher</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- The home screen must be there instantly when the foreground app closes: no window animation of its own. -->
    <style name="Animation.OpenLiquidLauncher" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/launcher_none</item>
        <item name="android:activityOpenExitAnimation">@anim/launcher_none</item>
        <item name="android:activityCloseEnterAnimation">@anim/launcher_none</item>
        <item name="android:activityCloseExitAnimation">@anim/launcher_none</item>
        <item name="android:taskOpenEnterAnimation">@anim/launcher_none</item>
        <item name="android:taskOpenExitAnimation">@anim/launcher_none</item>
        <item name="android:taskCloseEnterAnimation">@anim/launcher_none</item>
        <item name="android:taskCloseExitAnimation">@anim/launcher_none</item>
        <item name="android:taskToFrontEnterAnimation">@anim/launcher_none</item>
        <item name="android:taskToFrontExitAnimation">@anim/launcher_none</item>
        <item name="android:taskToBackEnterAnimation">@anim/launcher_none</item>
        <item name="android:taskToBackExitAnimation">@anim/launcher_none</item>
    </style>
</resources>
